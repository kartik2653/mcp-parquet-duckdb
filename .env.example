ANALYTICS_CONFIG=./configs/config.example.yaml
ANALYTICS_LISTEN_ADDR=:8080
ANALYTICS_TRANSPORT=http
ANALYTICS_PARQUET_PATH=./data/parquet/trips.parquet
ANALYTICS_DATASET_NAME=trips
ANALYTICS_DATASET_DESCRIPTION=Synthetic fleet trips for local analytics
ANALYTICS_METADATA_PATH=./configs/trips.metadata.example.yaml
ANALYTICS_DUCKDB_MEMORY_LIMIT=512MB
ANALYTICS_TEMP_DIR=./data/tmp
ANALYTICS_QUERY_TIMEOUT=30s
ANALYTICS_MAX_CONCURRENT_QUERIES=4
ANALYTICS_MAX_RESULT_ROWS=100
ANALYTICS_MAX_GROUPS=100
ANALYTICS_MAX_HISTOGRAM_BINS=20
ANALYTICS_AUTH_TOKEN=change-me
ANALYTICS_LOG_LEVEL=info
ANALYTICS_DEFAULT_TIMEZONE=UTC
ANALYTICS_MAX_REQUEST_BYTES=1048576
